<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Children Milestone Tracker</title>
<link rel="icon" type="image/svg+xml"
href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Ccircle cx='32' cy='18' r='10' fill='%23fbbf24'/%3E%3Cpath d='M16 54c0-12 7-20 16-20s16 8 16 20' fill='%238b5cf6'/%3E%3Cpath d='M22 10c3-5 15-6 20 0' stroke='%2392400e' stroke-width='4' fill='none'/%3E%3C/svg%3E">
<style>
:root{--b:#2563eb;--bs:#dbeafe;--g:#15803d;--gs:#f0fdf4;--y:#f59e0b;--ys:#fef3c7;--p:#7c3aed;--ps:#ede9fe;--r:#b91c1c;--i:#172033;--m:#64748b;--l:#dbe3ee;--bg:#f5f7fb}*{box-sizing:border-box}[hidden]{display:none!important}body{margin:0;padding:22px;background:var(--bg);color:var(--i);font:15px Segoe UI,Arial,sans-serif}.wrap{max-width:1450px;margin:auto}h1{color:#1d4ed8;margin:0 0 7px}.muted{color:var(--m)}.card{background:white;border:1px solid var(--l);border-radius:16px;padding:19px;margin:17px 0;box-shadow:0 6px 20px #0f172a10}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.child{border:1px solid var(--l);border-radius:12px;padding:14px}.child h2{text-align:center;color:#1d4ed8;font-size:18px}.photo{display:flex;flex-direction:column;align-items:center;gap:8px}.slot,.placeholder,.preview{width:124px;height:124px;border-radius:50%}.placeholder{display:flex;align-items:center;justify-content:center;text-align:center;border:2px dashed #9fb3cc;background:#f5f9ff;color:var(--m);cursor:pointer;padding:12px}.preview{object-fit:cover;border:4px solid white;box-shadow:0 0 0 2px var(--bs)}.file{position:absolute;width:1px;height:1px;clip:rect(0,0,0,0)}label{display:block;font-weight:650;font-size:13px;margin:10px 0 5px}input,select{width:100%;padding:10px;border:1px solid #bac5d4;border-radius:8px;font:inherit}.settings{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin-top:15px}.types{margin-top:15px;padding:14px;border:1px solid var(--l);border-radius:12px;background:#f8fafc}.types h3{margin:0 0 4px}.checks{display:flex;flex-wrap:wrap;gap:10px;margin-top:10px}.check{display:flex;align-items:center;gap:8px;margin:0;padding:10px 13px;border:1px solid var(--l);border-radius:9px;background:white;cursor:pointer}.check:has(input:checked){background:var(--bs);border-color:#60a5fa;color:#1d4ed8}.check input{width:18px;height:18px;margin:0}.actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:16px}button,.btn{border:0;border-radius:9px;padding:10px 14px;font:inherit;font-weight:700;cursor:pointer;background:#e8edf5}.primary{background:var(--b);color:white}.danger{color:var(--r)}.linkbtn{padding:4px;background:transparent;color:var(--b)}.notice{padding:12px;border-radius:10px;background:#fff7ed;border:1px solid #fed7aa;color:#9a3412;margin-top:14px}.ok{background:#eff6ff;border-color:#93c5fd;color:#1e40af}.summary{display:grid;grid-template-columns:repeat(3,1fr);gap:11px}.sum{border:1px solid var(--l);border-radius:11px;padding:13px}.next{border-left:5px solid var(--b);background:#eff6ff;padding:15px;border-radius:11px;margin:15px 0}.table{overflow:auto;border:1px solid var(--l);border-radius:12px;margin-top:12px}table{border-collapse:collapse;width:100%;min-width:920px}th,td{padding:10px 11px;border-bottom:1px solid #e5e7eb;text-align:left;white-space:nowrap}th{background:var(--bs);color:#1d4ed8;position:sticky;top:0}.year td{background:var(--ys)}.month td{background:var(--ps)}.birth td{background:#fce7f3}.badge{display:inline-block;padding:4px 8px;border-radius:999px;font-weight:600;background:var(--bs);color:#1d4ed8}.year .badge{background:var(--y);color:#422006}.month .badge{background:var(--p);color:white}.birth .badge{background:#db2777;color:white}.owner{background:var(--gs)!important;color:var(--g);font-weight:700}.soon{color:var(--r);font-weight:700}.save-state{font-size:12px;color:var(--m);margin-left:auto;align-self:center}.section-title{margin:22px 0 5px}.toast{position:fixed;right:20px;bottom:20px;z-index:1000;max-width:390px;padding:14px 44px 14px 16px;border-radius:12px;background:#ecfdf5;border:1px solid #86efac;color:#166534;box-shadow:0 12px 30px #0f172a25}.toast-close{position:absolute;right:8px;top:8px;padding:5px 9px;background:transparent;color:#166534}@media(max-width:850px){.grid,.settings,.summary{grid-template-columns:1fr}.save-state{width:100%;margin:0}}@media print{.input{display:none}.card{box-shadow:none}.table{overflow:visible}body{background:white}}
</style></head>
<body><main class="wrap"><h1>Children Milestone Tracker</h1><p class="muted">Compare year, month-anniversary, week and day milestones in one chronological timeline. Dates use dd/mm/yyyy.</p>
<section class="card input"><div id="children" class="grid"></div>
<div class="types"><h3>Milestone types to display</h3><span class="muted">Enable one type, any combination, or all types.</span><div class="checks"><label class="check"><input class="type" type="checkbox" value="birth" checked>Birthday (actual DOB)</label><label class="check"><input class="type" type="checkbox" value="year" checked>Years</label><label class="check"><input class="type" type="checkbox" value="month" checked>Month</label><label class="check"><input class="type" type="checkbox" value="week" checked>Weeks</label><label class="check"><input class="type" type="checkbox" value="day" checked>Days</label></div><button class="linkbtn" id="all" type="button">Select all</button><button class="linkbtn" id="none" type="button">Clear selection</button></div>
<div class="settings"><div><label for="maxDays">Last day milestone</label><input id="maxDays" type="number" min="100" step="100" value="10000"></div><div><label for="maxYears">Last yearly anniversary</label><input id="maxYears" type="number" min="1" max="120" value="30"></div><div><label for="maxMonths">Last month anniversary</label><input id="maxMonths" type="number" min="1" max="1440" value="120"></div><div><label for="maxWeeks">Last week milestone</label><input id="maxWeeks" type="number" min="1" max="10000" value="1000"></div><div><label for="lead">Notify before</label><select id="lead"><option value="0">On the day</option><option value="1">1 day</option><option value="7" selected>7 days</option><option value="30">30 days</option></select></div><div><label for="notify">Notification check</label><select id="notify"><option value="on">Enabled</option><option value="off">Disabled</option></select></div></div>
<div class="actions"><button class="primary" id="generate">Generate comparison</button><button id="save">Save now</button><button id="permission">Enable browser notifications</button><button id="ics">Download selected milestones (.ics)</button><button id="print">Print</button><button class="danger" id="clear">Clear saved data</button><span id="saveState" class="save-state">Auto-save ready</span></div><div id="status" class="notice ok">Changes are saved automatically in this browser and restored when this file is reopened.</div><div class="notice"><strong>Closed-browser limitation:</strong> this offline file cannot issue notifications while the browser is fully closed. Import the generated .ics file into your calendar for reliable alerts.</div></section>
<section id="results" class="card" hidden><div id="summary" class="summary"></div><div id="next"></div><div id="tables"></div></section><div id="restoreToast" class="toast" hidden><button id="closeToast" class="toast-close">×</button><strong>Saved data restored automatically</strong><div id="restoreMessage"></div></div></main>
<script>
const DAY=864e5,$=id=>document.getElementById(id),KEY='childrenMilestonesMultiUnitV7';let events=[],loading=false,timer=null,dirty=false;
$('children').innerHTML=[1,2,3].map(i=>`<div class="child"><h2>Child ${i}</h2><div class="photo"><div class="slot"><label id="ph${i}" class="placeholder" for="pic${i}">Choose a picture</label><img id="img${i}" class="preview" alt="Child ${i} picture" hidden></div><input id="pic${i}" class="file" type="file" accept="image/*"><div><label class="btn" for="pic${i}">Upload / change</label> <button id="rm${i}" type="button" hidden>Remove</button></div></div><label for="name${i}">Name</label><input id="name${i}" value="Child ${String.fromCharCode(64+i)}"><label for="dob${i}">Date of birth</label><input id="dob${i}" inputmode="numeric" maxlength="10" placeholder="dd/mm/yyyy"></div>`).join('');
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function parse(v){const m=v.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);if(!m)return null;const x=new Date(Date.UTC(+m[3],+m[2]-1,+m[1]));return x.getUTCDate()==+m[1]&&x.getUTCMonth()==+m[2]-1&&x.getUTCFullYear()==+m[3]?x:null}function fmt(x){return`${String(x.getUTCDate()).padStart(2,'0')}/${String(x.getUTCMonth()+1).padStart(2,'0')}/${x.getUTCFullYear()}`}function today(){const n=new Date;return new Date(Date.UTC(n.getFullYear(),n.getMonth(),n.getDate()))}function addDays(x,n){return new Date(x.getTime()+n*DAY)}function dif(a,b){return Math.round((a-b)/DAY)}function dim(y,m){return new Date(Date.UTC(y,m+1,0)).getUTCDate()}function addMonths(d,n){const total=d.getUTCMonth()+n,y=d.getUTCFullYear()+Math.floor(total/12),m=((total%12)+12)%12;return new Date(Date.UTC(y,m,Math.min(d.getUTCDate(),dim(y,m))))}function addYears(d,n){return addMonths(d,n*12)}function selected(){return [...document.querySelectorAll('.type:checked')].map(x=>x.value)}function label(e){return e.type==='birth'?'Birthday (born)':e.type==='year'?`${e.v}${ord(e.v)} birthday`:e.type==='month'?`${e.v}${ord(e.v)} month`:e.type==='week'?`${e.v.toLocaleString()} weeks`:`${e.v.toLocaleString()} days`}function ord(n){const m=n%100;if(m>10&&m<14)return'th';return n%10==1?'st':n%10==2?'nd':n%10==3?'rd':'th'}function dateFor(d,type,v){return type==='birth'?d:type==='year'?addYears(d,v):type==='month'?addMonths(d,v):type==='week'?addDays(d,v*7):addDays(d,v)}function completedMonths(d,x){let n=(x.getUTCFullYear()-d.getUTCFullYear())*12+x.getUTCMonth()-d.getUTCMonth();if(addMonths(d,n)>x)n--;return Math.max(0,n)}
function setPic(i,data,saveAfter=true){const im=$('img'+i),ph=$('ph'+i),rm=$('rm'+i);if(!data){im.hidden=true;im.removeAttribute('src');ph.hidden=false;rm.hidden=true;$('pic'+i).value=''}else{im.src=data;im.hidden=false;ph.hidden=true;rm.hidden=false}if(saveAfter)queueSave()}function resizePhoto(file,done){const r=new FileReader;r.onload=()=>{const im=new Image;im.onload=()=>{const s=320,c=document.createElement('canvas');c.width=c.height=s;const q=c.getContext('2d'),z=Math.max(s/im.width,s/im.height),w=im.width*z,h=im.height*z;q.drawImage(im,(s-w)/2,(s-h)/2,w,h);done(c.toDataURL('image/jpeg',.82))};im.src=r.result};r.readAsDataURL(file)}
[1,2,3].forEach(i=>{$('dob'+i).addEventListener('input',e=>{let v=e.target.value.replace(/\D/g,'').slice(0,8);e.target.value=v.length>4?v.slice(0,2)+'/'+v.slice(2,4)+'/'+v.slice(4):v.length>2?v.slice(0,2)+'/'+v.slice(2):v});$('pic'+i).addEventListener('change',e=>{const f=e.target.files[0];if(f&&f.type.startsWith('image/'))resizePhoto(f,d=>setPic(i,d))});$('rm'+i).onclick=()=>setPic(i,null)});
function project(){return{children:[1,2,3].map(i=>({name:$('name'+i).value,dob:$('dob'+i).value,pic:$('img'+i).getAttribute('src')||''})),types:selected(),maxDays:$('maxDays').value,maxYears:$('maxYears').value,maxMonths:$('maxMonths').value,maxWeeks:$('maxWeeks').value,lead:$('lead').value,notify:$('notify').value,savedAt:new Date().toISOString()}}function save(show=true){if(loading)return;try{localStorage.setItem(KEY,JSON.stringify(project()));dirty=false;$('saveState').textContent='Saved '+new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});if(show)$('status').textContent='Saved successfully in this browser.'}catch{$('status').textContent='Could not save. Browser storage may be unavailable or full.'}}function queueSave(){if(loading)return;dirty=true;clearTimeout(timer);$('saveState').textContent='Saving...';timer=setTimeout(()=>save(false),350)}
document.addEventListener('input',e=>{if(e.target.matches('input:not([type=file]),select'))queueSave()});document.addEventListener('change',e=>{if(e.target.matches('input:not([type=file]),select'))queueSave()});
function load(){loading=true;try{const raw=localStorage.getItem(KEY);if(!raw)return;const x=JSON.parse(raw);x.children.forEach((c,j)=>{const i=j+1;$('name'+i).value=c.name||`Child ${i}`;$('dob'+i).value=c.dob||'';setPic(i,c.pic||null,false)});['maxDays','maxYears','maxMonths','maxWeeks','lead','notify'].forEach(k=>{if(x[k]!=null)$(k).value=x[k]});if(Array.isArray(x.types))document.querySelectorAll('.type').forEach(t=>t.checked=x.types.includes(t.value));$('saveState').textContent='Saved data restored';if(x.savedAt){$('restoreMessage').textContent='Last saved: '+new Date(x.savedAt).toLocaleString();$('restoreToast').hidden=false;setTimeout(()=>$('restoreToast').hidden=true,8000)}}catch{$('status').textContent='Saved data could not be restored.'}finally{loading=false}}
function values(type){if(type==='birth')return[0];const max={day:+$('maxDays').value,year:+$('maxYears').value,month:+$('maxMonths').value,week:+$('maxWeeks').value}[type],a=[];if(type==='day'){for(let n=10;n<100&&n<=max;n+=10)a.push(n);for(let n=100;n<=max;n+=100)a.push(n)}else if(type==='week'){for(let n=1;n<=Math.min(12,max);n++)a.push(n);for(let n=16;n<=Math.min(52,max);n+=4)a.push(n);for(let n=100;n<=max;n+=100)a.push(n)}else for(let n=1;n<=max;n++)a.push(n);return a}
function build(){const cs=[1,2,3].map(i=>({name:$('name'+i).value.trim()||`Child ${i}`,dob:parse($('dob'+i).value)}));if(cs.some(c=>!c.dob)){alert('Enter all three dates in dd/mm/yyyy format.');return null}const types=selected();if(!types.length){alert('Select at least one milestone type.');return null}let ev=[];types.forEach(type=>values(type).forEach(v=>cs.forEach((c,o)=>ev.push({type,v,o,date:dateFor(c.dob,type,v)}))));ev.sort((a,b)=>a.date-b.date||a.o-b.o);return{cs,types,ev}}
function generate(store=true){const x=build();if(!x)return;events=x.ev.map(e=>({...e,name:x.cs[e.o].name}));const t=today();$('summary').innerHTML=x.cs.map(c=>{const d=dif(t,c.dob);return`<div class="sum"><b>${esc(c.name)}</b><h2>${d<0?'Not born yet':d.toLocaleString()+' days'}</h2><span class="muted">Born ${fmt(c.dob)}</span></div>`}).join('');const future=x.ev.filter(e=>e.date>=t),overall=future[0];$('next').innerHTML=overall?`<div class="next"><h2>Next selected milestone overall</h2>${esc(x.cs[overall.o].name)}: ${label(overall)} on ${fmt(overall.date)}. <b>${dif(overall.date,t)} days remaining</b></div>`:'<div class="next">No future selected milestone.</div>';
$('tables').innerHTML=`<h2 class="section-title">All selected milestones in chronological order</h2><p class="muted">Year, month-anniversary, week and day milestones are combined below and sorted by date.</p><div class="table"><table><thead><tr><th>Date</th><th>Milestone</th><th>Type</th><th>Age in months</th>${x.cs.map(c=>`<th>${esc(c.name)} age on this date</th>`).join('')}</tr></thead><tbody>${x.ev.map(e=>{const typeName={birth:'Birthday',year:'Year',month:'Month',week:'Week',day:'Day'}[e.type];return`<tr class="${e.type}"><td>${fmt(e.date)}</td><td><span class="badge">${esc(x.cs[e.o].name)}: ${label(e)}</span></td><td>${typeName}</td><td>${completedMonths(x.cs[e.o].dob,e.date).toLocaleString()} months</td>${x.cs.map((c,i)=>{const days=dif(e.date,c.dob),weeks=Math.floor(days/7),months=completedMonths(c.dob,e.date),years=Math.floor(months/12);return`<td class="${i===e.o?'owner':''}">${days<0?'Not born yet':`${years} y · ${months} mo · ${weeks} wk ··· ${days.toLocaleString()} d`}</td>`}).join('')}</tr>`}).join('')}</tbody></table></div>`;$('results').hidden=false;if(store)save(false);checkNotifications()}
async function permission(){if(!('Notification'in window))return alert('Notifications are not supported in this browser.');$('status').textContent='Notification permission: '+await Notification.requestPermission()}function checkNotifications(){if($('notify').value!=='on'||!('Notification'in window)||Notification.permission!=='granted'||!events.length)return;const t=today(),lead=+$('lead').value,sent=JSON.parse(localStorage.getItem(KEY+'Sent')||'{}');events.forEach(e=>{const left=dif(e.date,t),id=e.name+'|'+e.type+'|'+e.v+'|'+fmt(e.date)+'|'+lead;if(left===lead&&!sent[id]){new Notification('Milestone reminder',{body:`${e.name}: ${label(e)} ${left?'in '+left+' days':'today'} (${fmt(e.date)})`});sent[id]=true}});localStorage.setItem(KEY+'Sent',JSON.stringify(sent))}
function ics(){const x=build();if(!x)return;const lead=+$('lead').value,dt=d=>`${d.getUTCFullYear()}${String(d.getUTCMonth()+1).padStart(2,'0')}${String(d.getUTCDate()).padStart(2,'0')}`,lines=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//Children Milestones//EN','CALSCALE:GREGORIAN'];x.ev.forEach(e=>{const title=`${x.cs[e.o].name}: ${label(e)}`;lines.push('BEGIN:VEVENT',`UID:${e.o}-${e.type}-${e.v}@milestones.local`,`DTSTART;VALUE=DATE:${dt(e.date)}`,`DTEND;VALUE=DATE:${dt(addDays(e.date,1))}`,`SUMMARY:${title.replace(/[,;]/g,' ')}`,'TRANSP:TRANSPARENT','BEGIN:VALARM',`TRIGGER:-P${lead}D`,'ACTION:DISPLAY',`DESCRIPTION:${title.replace(/[,;]/g,' ')}`,'END:VALARM','END:VEVENT')});lines.push('END:VCALENDAR');const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([lines.join('\r\n')],{type:'text/calendar'}));a.download='children_selected_milestones.ics';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}
$('generate').onclick=()=>generate();$('save').onclick=()=>save(true);$('permission').onclick=permission;$('ics').onclick=ics;$('print').onclick=()=>print();$('all').onclick=()=>{document.querySelectorAll('.type').forEach(x=>x.checked=true);queueSave()};$('none').onclick=()=>{document.querySelectorAll('.type').forEach(x=>x.checked=false);queueSave()};$('closeToast').onclick=()=>$('restoreToast').hidden=true;$('clear').onclick=()=>{if(!confirm('Clear all saved data and start again?'))return;localStorage.removeItem(KEY);localStorage.removeItem(KEY+'Sent');dirty=false;location.reload()};window.addEventListener('beforeunload',e=>{if(dirty){e.preventDefault();e.returnValue=''}});window.addEventListener('pagehide',()=>{if(dirty)save(false)});setInterval(checkNotifications,60000);load();if([1,2,3].every(i=>parse($('dob'+i).value)))generate(false);
</script></body></html>
